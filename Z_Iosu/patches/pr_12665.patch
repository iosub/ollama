+	if slices.Contains(shape, -1) {
+		inferShape(t, shape)
+	}
+
 	switch len(shape) {
 	case 0:
 		return &Tensor{
@@ -1296,7 +1301,35 @@ func (t *Tensor) Copy(ctx ml.Context, t2 ml.Tensor) ml.Tensor {
 	}
 }
 
+func inferShape(t *Tensor, shape []int) {
+	total := 1
+	for _, dim := range t.Shape() {
+		total *= dim
+	}
+
+	dim := -1
+	for i := range shape {
+		if shape[i] > 0 {
+			total /= shape[i]
+		} else if shape[i] == -1 {
+			if dim != -1 {
+				panic("only one dimension can be inferred")
+			}
+
+			dim = i
+		}
+	}
+
+	if dim != -1 {
+		shape[dim] = total
+	}
+}
+
