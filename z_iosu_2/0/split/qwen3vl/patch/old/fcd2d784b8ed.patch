+	if chunk == "" && seq.prefaceBuffer == "" {
+		return ""
+	}
+
+	combined := seq.prefaceBuffer + chunk
+	match := assistantPrefaceMatchLen(combined)
+
+	if len(combined) < len(assistantPreface) && match == len(combined) {
+		seq.prefaceBuffer = combined
+		return ""
+	}
+
+	if strings.HasPrefix(combined, assistantPreface) {
+		seq.trimmedAssistantPreface = true
+		seq.prefaceBuffer = ""
+		return combined[len(assistantPreface):]
+	}
+
+	// If the generated text diverges from the expected preface, flush everything as-is.
+	seq.trimmedAssistantPreface = true
+	seq.prefaceBuffer = ""
+	return combined
+}
+
+func assistantPrefaceMatchLen(s string) int {
+	max := len(assistantPreface)
+	if len(s) < max {
