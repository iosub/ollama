+func (seq *Sequence) deferStop(stop string) {
+	if len(seq.stop) == 0 {
+		return
+	}
+
+	filtered := seq.stop[:0]
+	for _, candidate := range seq.stop {
+		if candidate == stop {
+			seq.deferredStops = append(seq.deferredStops, candidate)
+			continue
+		}
+		filtered = append(filtered, candidate)
+	}
+
+	seq.stop = filtered
+}
+
+func (seq *Sequence) restoreDeferredStops() {
+	if len(seq.deferredStops) == 0 {
+		return
+	}
+
+	seq.stop = append(seq.stop, seq.deferredStops...)
+	seq.deferredStops = nil
+}
+
+func trimAssistantPreface(seq *Sequence, chunk string) string {
+	if seq.trimmedAssistantPreface {
+		return chunk
+	}
+
+	if chunk == "" && seq.prefaceBuffer == "" {
+		return ""
+	}
+
+	combined := seq.prefaceBuffer + chunk
+	match := assistantPrefaceMatchLen(combined)
+
+	if len(combined) < len(assistantPreface) && match == len(combined) {
+		seq.prefaceBuffer = combined
+		return ""
+	}
+
+	if strings.HasPrefix(combined, assistantPreface) {
+		seq.trimmedAssistantPreface = true
+		seq.prefaceBuffer = ""
+		return combined[len(assistantPreface):]
+	}
+
+	// If the generated text diverges from the expected preface, flush everything as-is.
+	seq.trimmedAssistantPreface = true
+	seq.prefaceBuffer = ""
+	return combined
+}
+
+func assistantPrefaceMatchLen(s string) int {
+	max := len(assistantPreface)
+	if len(s) < max {
+		max = len(s)
+	}
+
+	for i := 0; i < max; i++ {
+		if s[i] != assistantPreface[i] {
+			return i
+		}
+	}
+
+	return max
+}
+
+func hasOnlyAssistantPreface(seq *Sequence) bool {
+	if seq.trimmedAssistantPreface {
+		return false
+	}
+
+	combined := seq.prefaceBuffer + strings.Join(seq.pendingResponses, "")
+	if combined == "" {
+		return false
+	}
+
+	match := assistantPrefaceMatchLen(combined)
+	return match == len(combined) && len(combined) <= len(assistantPreface)
+}
